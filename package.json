{
  "name": "ledgerline",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src infra scripts \"*.{mts,mjs}\" next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:db:fresh": "tsx scripts/test-db-fresh.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo:users": "tsx scripts/create-demo-users.ts",
    "ai:models": "tsx scripts/ai-models.ts",
    "cdk": "cd infra && cdk"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1157.0",
    "@aws-sdk/client-rds-data": "3.1157.0",
    "@aws-sdk/client-secrets-manager": "3.1157.0",
    "aws-jwt-verify": "5.2.1",
    "next": "15.5.28",
    "pg": "8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@aws-sdk/client-sts": "3.1157.0",
    "@eslint/eslintrc": "^3",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aws-cdk": "^2.1146.1",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
