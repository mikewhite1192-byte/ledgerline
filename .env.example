# Copy to .env.local and fill in. Never commit real values.

# Meta Model API (Muse Spark, Muse Wonder, Muse Voice, Muse Image, SAM)
# The raw key, local development only (refused when DB_CLUSTER_ARN is set).
META_API_KEY=
# The exact model id for each slot, as GET /v1/models lists it (`npm run ai:models` checks them).
META_MODEL_SPARK=muse-spark-1.3
META_MODEL_WONDER=muse-wonder-1.0
META_MODEL_VOICE=muse-voice-transcribe-1.0
META_MODEL_IMAGE=muse-image-1.0
META_MODEL_SAM=sam-3.1
# Spark's cheaper Contributor tier: Meta may train on content sent in this mode, so synthetic data only.
META_CONTRIBUTOR_MODE=false
# Amplify only: the Secrets Manager name the server reads the key from.
META_API_KEY_SECRET_NAME=

# Baseten (Muse Spark Open)
# The raw key, local development only (refused when DB_CLUSTER_ARN is set).
BASETEN_API_KEY=
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
# Amplify only: the Secrets Manager name the server reads the key from.
BASETEN_API_KEY_SECRET_NAME=

# AI budget guard (cents). A call is refused when the spent plus reserved total would pass this.
# Unset, zero or above the 15000-cent credit refuses every call.
AI_SPEND_CAP_CENTS=12000
# Muse Wonder's own stop inside the cap above (cents). Unset, zero or above AI_SPEND_CAP_CENTS
# refuses Wonder calls only.
AI_WONDER_CAP_CENTS=3000

# QuickBooks Online (sandbox company only; the server refuses to start with anything else)
QBO_CLIENT_ID=
# The raw client secret, local development only (refused when DB_CLUSTER_ARN is set).
QBO_CLIENT_SECRET=
# Locally http://localhost:3000/api/qbo/callback; it must also be registered on the Intuit app.
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox
# The one sandbox company a carrier may connect, compared as a whole string. Never commit it.
QBO_ALLOWED_REALM_ID=
# The key that seals the QuickBooks tokens at rest, local development only (refused when
# DB_CLUSTER_ARN is set). Make one with `openssl rand -base64 32`.
QBO_TOKEN_KEY=
QBO_MINOR_VERSION=75
# Amplify only: the Secrets Manager names the server reads the two secrets above from.
QBO_CLIENT_SECRET_NAME=
QBO_TOKEN_KEY_SECRET_NAME=

# Payment adapter (test mode only)
PAYMENT_PROVIDER=mock
# A Stripe test secret key, local development only (refused when DB_CLUSTER_ARN is set). The
# server refuses to start with a live key.
STRIPE_SECRET_KEY=
# The one Stripe test connected account demo payouts go to.
STRIPE_TEST_DESTINATION_ACCOUNT=
# Amplify only: the Secrets Manager name the server reads the Stripe test key from.
STRIPE_SECRET_KEY_SECRET_NAME=

# AWS (one region for the whole stack)
AWS_REGION=us-east-2

# Aurora PostgreSQL Serverless v2, reached through the Data API
# Cluster ARN the Data API calls target.
DB_CLUSTER_ARN=
# Secrets Manager ARN of the app's database login (the ARN only, never the password).
DB_SECRET_ARN=
# Database name inside the cluster.
DB_NAME=
# Secrets Manager ARN of the migrating admin login. Laptop only, never Amplify: used by
# `npm run db:migrate -- --target aurora` and `npm run demo:users`.
DB_ADMIN_SECRET_ARN=
# The project's 12-digit AWS account id. Laptop only: the scripts above refuse other accounts.
EXPECTED_AWS_ACCOUNT_ID=

# Cognito (login)
# User pool that signs users in.
COGNITO_USER_POOL_ID=
# App client id within that pool.
COGNITO_CLIENT_ID=

# LOCAL Postgres 16 admin login for `npm run test:db:fresh` and local dev, for example
# postgresql://postgres@localhost:5432/postgres. Never production.
DATABASE_URL=

# AWS inbound email (SES -> S3 -> Lambda), in AWS_REGION above
INBOUND_EMAIL_BUCKET=
INBOUND_EMAIL_DOMAIN=
