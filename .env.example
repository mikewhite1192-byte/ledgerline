# Copy to .env.local and fill in. Never commit real values.

# Meta Model API (Muse Spark)
# The raw key, local development only (refused when DB_CLUSTER_ARN is set).
META_API_KEY=
META_MODEL_ID=muse-spark-1.3
# Amplify only: the Secrets Manager name the server reads the key from.
META_API_KEY_SECRET_NAME=

# Baseten (Muse Spark Open)
# The raw key, local development only (refused when DB_CLUSTER_ARN is set).
BASETEN_API_KEY=
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
# Amplify only: the Secrets Manager name the server reads the key from.
BASETEN_API_KEY_SECRET_NAME=

# AI budget guard (cents). A call is refused when the spent plus reserved total would pass this.
# Unset, zero or above the 15000-cent credit refuses every call.
AI_SPEND_CAP_CENTS=12000

# QuickBooks Online (sandbox company only)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox

# Payment adapter (test mode only)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=

# AWS (one region for the whole stack)
AWS_REGION=us-east-2

# Aurora PostgreSQL Serverless v2, reached through the Data API
# Cluster ARN the Data API calls target.
DB_CLUSTER_ARN=
# Secrets Manager ARN of the app's database login (the ARN only, never the password).
DB_SECRET_ARN=
# Database name inside the cluster.
DB_NAME=
# Secrets Manager ARN of the migrating admin login. Laptop only, never Amplify: used by
# `npm run db:migrate -- --target aurora` and `npm run demo:users`.
DB_ADMIN_SECRET_ARN=
# The project's 12-digit AWS account id. Laptop only: the scripts above refuse other accounts.
EXPECTED_AWS_ACCOUNT_ID=

# Cognito (login)
# User pool that signs users in.
COGNITO_USER_POOL_ID=
# App client id within that pool.
COGNITO_CLIENT_ID=

# LOCAL Postgres 16 admin login for `npm run test:db:fresh` and local dev, for example
# postgresql://postgres@localhost:5432/postgres. Never production.
DATABASE_URL=

# AWS inbound email (SES -> S3 -> Lambda), in AWS_REGION above
INBOUND_EMAIL_BUCKET=
INBOUND_EMAIL_DOMAIN=
